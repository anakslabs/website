{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/products/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/:path+/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guides/",
      "destination": "/articles/",
      "permanent": true
    },
    {
      "source": "/guides/:path+/",
      "destination": "/articles/:path+/",
      "permanent": true
    },
    {
      "source": "/blog/hello/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/hello/:path+/",
      "destination": "/",
      "permanent": true
    }
  ]
}
