{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/guides/",
      "destination": "/articles/",
      "permanent": true
    },
    {
      "source": "/guides/:path+/",
      "destination": "/articles/:path+/",
      "permanent": true
    },
    {
      "source": "/blog/hello/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/hello/:path+/",
      "destination": "/",
      "permanent": true
    }
  ]
}
